# Copy this file to .env and put the key THERE, not here.
#   cp .env.example .env
#
# .env is gitignored. THIS file is committed, so it must never contain a real key.
#
# The service runs fine without a key: explanations fall back to a deterministic
# template, and the decision itself never depends on the API.
ANTHROPIC_API_KEY=

# Optional: override the model used for explanation text.
FRAUDSPIKE_CLAUDE_MODEL=claude-sonnet-5
